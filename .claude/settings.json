{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Bash(xcodebuild*)",
      "Bash(xcrun*)",
      "Bash(git*)",
      "Bash(swift*)",
      "Bash(open*)",
      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(find*)",
      "Bash(grep*)",
      "Bash(mkdir*)",
      "Bash(cp*)",
      "Bash(mv*)",
      "Bash(rm*)"
    ],
    "deny": []
  },
  "mcpServers": {
    "XcodeBuildMCP": {
      "command": "npx",
      "args": ["-y", "xcodebuildmcp@latest"],
      "env": {}
    }
  }
}
